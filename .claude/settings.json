{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-activate.js\"", "timeout": 15 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/always-on.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-subagent.js\"", "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ponytail-mode-tracker.js\"", "timeout": 15 } ] }
    ]
  }
}
